# Copy to paperleaf_agent/.env for local development. Never commit the real .env file.
GOOGLE_API_KEY=your-gemini-key

# Optional locally (the defaults work for development):
# DATABASE_URL=postgresql://user:password@host/dbname   # omit to use a local SQLite file
# ADMIN_PASSCODE=admin-demo
# JWT_SECRET=a-long-random-string-of-32-or-more-characters
# ALLOWED_ORIGINS=http://localhost:3001
# FALLBACK_MODEL=gemini-3.5-flash

# Production only (Render):
# APP_ENV=production   # makes the API refuse to start with weak or missing secrets
